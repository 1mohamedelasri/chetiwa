CHETIWA_ENV=production
PORT=8080
GOOGLE_CLOUD_PROJECT=chetiwa
FIRESTORE_DATABASE_ID=(default)

PUBLIC_BASE_URL=https://api.ezplatforms.com
# Required before switching CHETIWA_ENV to production. Keep the server in
# staging for closed beta until a commercial Open-Meteo key is available.
# OPEN_METEO_API_KEY=store-only-in-production.env
# ARCGIS_API_KEY=store-only-in-production.env
RADAR_ENABLED=true
RADAR_PROVIDER=librewxr
RADAR_METADATA_URL=https://radar.ezplatforms.com/public/weather-maps.json
RADAR_TILE_URL_TEMPLATE=https://radar.ezplatforms.com{frame}/256/{z}/{x}/{y}/13/1_0.png

# Safe launch: measure usage without denying the core Radar feature.
RADAR_QUOTA_ENFORCED=false
RADAR_FREE_SESSIONS=20
RADAR_PREMIUM_SESSIONS=200
MONTHLY_BUDGET_CENTS=10000
RADAR_TILE_COST_CENTS=0
GLOBAL_KILL_SWITCH=false
PREMIUM_ENABLED=false
PREMIUM_ROLLOUT_PERCENT=0
ADS_ENABLED=false

# Firestore is intentionally not contacted while both flags are false.
RAIN_ALERTS_ENABLED=false
RAIN_ALERTS_SEND_ENABLED=false
RAIN_ALERT_SOFT_BUDGET_CENTS=2500
RAIN_ALERT_HARD_BUDGET_CENTS=5000
RAIN_ALERT_BUDGET_CURRENCY=EUR
RAIN_ALERT_CELL_SIZE_DEGREES=0.05
RAIN_ALERT_MAX_CONCURRENT_CELLS=8

# Generate a long random value on the server. Never commit production.env.
INTERNAL_METRICS_TOKEN=replace-on-server
