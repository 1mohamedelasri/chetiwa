CHETIWA_ENV=local
PORT=8080
RADAR_ENABLED=true
RADAR_FREE_SESSIONS=20
RADAR_PREMIUM_SESSIONS=200
MONTHLY_BUDGET_CENTS=10000
# Per-origin tile price in cents. LibreWXR beta is 0; set a real amount only
# when switching to a billed supplier.
RADAR_TILE_COST_CENTS=0
GLOBAL_KILL_SWITCH=false
# LibreWXR is the default. Override only to test another authorised supplier.
# RADAR_METADATA_URL=https://api.librewxr.net/public/weather-maps.json
# RADAR_TILE_URL_TEMPLATE=https://api.librewxr.net{frame}/256/{z}/{x}/{y}/10/1_1.png
# SHARED_COUNTER_URL=http://shared-counter:8081/increment
# PUBLIC_BASE_URL=http://localhost:8080
# INTERNAL_METRICS_TOKEN=local-only-token
# Les valeurs suivantes restent optionnelles en développement.
# OPEN_METEO_API_KEY=
# OPEN_METEO_METEOFRANCE_URL=https://api.open-meteo.com/v1/meteofrance
# ARCGIS_API_KEY=
