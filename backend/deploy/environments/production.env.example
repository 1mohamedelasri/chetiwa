CHETIWA_ENV=production
PORT=8080
RADAR_ENABLED=true
RADAR_FREE_SESSIONS=20
RADAR_PREMIUM_SESSIONS=200
MONTHLY_BUDGET_CENTS=10000
RADAR_TILE_COST_CENTS=0
GLOBAL_KILL_SWITCH=false
GOOGLE_CLOUD_PROJECT=replace-with-chetiwa-production-project-id
# Obligatoire avant mise en production monétisée :
# OPEN_METEO_API_KEY (Secret Manager, contrat commercial)
# ARCGIS_API_KEY (Secret Manager, si ArcGIS est retenu)
# LibreWXR is reached through the Cloudflare Tunnel, never through the
# Hetzner IP. Keep these URLs identical for metadata and tile requests.
RADAR_METADATA_URL=https://radar.ezplatforms.com/public/weather-maps.json
RADAR_TILE_URL_TEMPLATE=https://radar.ezplatforms.com{frame}/256/{z}/{x}/{y}/10/1_1.png
# Attribution LibreWXR obligatoire dans l'app. Ne remplacer cette source qu'après
# validation des droits, du coût et du comportement de cache du nouveau service.
# SHARED_COUNTER_URL (service Redis/Firestore partagé, obligatoire avant autoscaling)
# PUBLIC_BASE_URL (URL HTTPS publique Cloud Run/CDN)
# INTERNAL_METRICS_TOKEN (Secret Manager, jamais dans le dépôt)
