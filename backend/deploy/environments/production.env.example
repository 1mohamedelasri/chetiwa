CHETIWA_ENV=production
PORT=8080
RADAR_ENABLED=true
# Bêta : compter les ouvertures sans bloquer. Activer seulement après validation
# serveur des achats et déploiement d'un compteur partagé.
RADAR_QUOTA_ENFORCED=false
RADAR_FREE_SESSIONS=20
RADAR_PREMIUM_SESSIONS=200
MONTHLY_BUDGET_CENTS=10000
RADAR_TILE_COST_CENTS=0
GLOBAL_KILL_SWITCH=false
# Safe launch defaults. Increase rollout only after store products and receipt
# validation are ready. These public flags never grant an entitlement.
PREMIUM_ENABLED=false
PREMIUM_ROLLOUT_PERCENT=0
# Model forecast remains Premium and independently controlled.
# Passer à true pour publier le segment verrouillé +60–120 min. Cela n'accorde
# aucun entitlement tant que PREMIUM_ENABLED reste false.
PREMIUM_RADAR_MODEL_ENABLED=false
ADS_ENABLED=false
# One-time, optional statistics/diagnostics choice. This never enables Ads.
ANALYTICS_CONSENT_PROMPT_ENABLED=true
GOOGLE_CLOUD_PROJECT=replace-with-chetiwa-production-project-id
FIRESTORE_DATABASE_ID=(default)
RAIN_ALERTS_ENABLED=false
RAIN_ALERTS_SEND_ENABLED=false
RAIN_ALERT_SOFT_BUDGET_CENTS=2500
RAIN_ALERT_HARD_BUDGET_CENTS=5000
RAIN_ALERT_BUDGET_CURRENCY=EUR
RAIN_ALERT_CELL_SIZE_DEGREES=0.05
RAIN_ALERT_MAX_CONCURRENT_CELLS=8
# Obligatoire avant mise en production monétisée :
# OPEN_METEO_API_KEY (Secret Manager, contrat commercial)
# ARCGIS_API_KEY (Secret Manager, si ArcGIS est retenu)
# LibreWXR is reached through the Cloudflare Tunnel, never through the
# Hetzner IP. Keep these URLs identical for metadata and tile requests.
RADAR_METADATA_URL=https://radar.ezplatforms.com/public/weather-maps.json
RADAR_PROVIDER=librewxr
RADAR_TILE_URL_TEMPLATE=https://radar.ezplatforms.com{frame}/256/{z}/{x}/{y}/14/1_0.png?presentation=crisp-v2
PUBLIC_BASE_URL=https://chetiwa-api.ezplatforms.com
# Attribution LibreWXR obligatoire dans l'app. Ne remplacer cette source qu'après
# validation des droits, du coût et du comportement de cache du nouveau service.
# SHARED_COUNTER_URL (service Redis/Firestore partagé, obligatoire avant autoscaling)
# INTERNAL_METRICS_TOKEN (Secret Manager, jamais dans le dépôt)
