CHETIWA_ENV=staging
PORT=8080
RADAR_ENABLED=true
RADAR_FREE_SESSIONS=20
RADAR_PREMIUM_SESSIONS=200
MONTHLY_BUDGET_CENTS=10000
RADAR_TILE_COST_CENTS=1
GLOBAL_KILL_SWITCH=false
# RADAR_TILE_URL_TEMPLATE=https://staging-licensed-tiles.example/{frame}/{z}/{x}/{y}.png
# SHARED_COUNTER_URL=https://shared-counter-staging.example/increment
# PUBLIC_BASE_URL=https://api-staging.chetiwa.example
# INTERNAL_METRICS_TOKEN=inject-from-secret-manager
GOOGLE_CLOUD_PROJECT=replace-with-chetiwa-staging-project-id
# Injecter les valeurs secrètes au runtime, jamais dans ce fichier :
# OPEN_METEO_API_KEY (Secret Manager)
# ARCGIS_API_KEY (Secret Manager, si ArcGIS est retenu)
# Configurer RADAR_METADATA_URL vers le fournisseur staging autorisé.
