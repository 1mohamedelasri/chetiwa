+def _chetiwa_lut() -> np.ndarray:
+    """Sparse grey echoes with red precipitation cores, in dBZ."""
+    stops = (
+        (-32.0, (0, 0, 0, 0)),
+        (4.0, (0, 0, 0, 0)),
+        (6.0, (216, 220, 222, 110)),
+        (12.0, (194, 199, 201, 150)),
+        (18.0, (151, 157, 160, 185)),
+        (24.0, (88, 96, 100, 215)),
+        (28.0, (229, 177, 177, 225)),
+        (34.0, (224, 119, 116, 240)),
+        (40.0, (207, 63, 58, 250)),
+        (50.0, (174, 0, 0, 255)),
+        (95.0, (116, 0, 0, 255)),
+    )
+    lut = np.zeros((256, 4), dtype=np.uint8)
+    for pixel_value in range(256):
+        dbz = pixel_value / 2.0 - 32.0
+        for index in range(len(stops) - 1):
+            low_dbz, low_rgba = stops[index]
+            high_dbz, high_rgba = stops[index + 1]
+            if dbz <= high_dbz:
+                ratio = max(0.0, (dbz - low_dbz) / (high_dbz - low_dbz))
+                lut[pixel_value] = [
+                    round(low_rgba[channel] + ratio * (high_rgba[channel] - low_rgba[channel]))
+                    for channel in range(4)
+                ]
+                break
+        else:
+            lut[pixel_value] = stops[-1][1]
+    return lut
+
