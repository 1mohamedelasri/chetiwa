+def _chetiwa_crisp_lut() -> np.ndarray:
+    """Calm, discrete radar bands without interpolated red haze."""
+    bands = (
+        (4.0, (0, 0, 0, 0)),
+        (10.0, (216, 220, 222, 90)),
+        (16.0, (185, 190, 193, 125)),
+        (22.0, (135, 142, 146, 160)),
+        (28.0, (83, 91, 95, 190)),
+        (34.0, (225, 155, 152, 195)),
+        (40.0, (214, 91, 85, 215)),
+        (50.0, (188, 38, 32, 230)),
+        (95.0, (132, 0, 0, 240)),
+    )
+    lut = np.zeros((256, 4), dtype=np.uint8)
+    for pixel_value in range(256):
+        dbz = pixel_value / 2.0 - 32.0
+        for upper_dbz, rgba in bands:
+            if dbz <= upper_dbz:
+                lut[pixel_value] = rgba
+                break
+        else:
+            lut[pixel_value] = bands[-1][1]
+    return lut
+
