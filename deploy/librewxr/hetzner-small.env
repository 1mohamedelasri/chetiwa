# Chetiwa's low-cost LibreWXR profile for a small Hetzner VM.
#
# This is intentionally Europe-first, with LibreWXR's global RRQPE/IFS
# fallback. It is NOT a full global native-radar deployment. Chetiwa's graph
# remains the truthful source for the now -> +2h point forecast.

COMPOSE_PROFILES=single

# LibreWXR expects an integer container port. Keep the public host binding
# private in docker-compose; cloudflared is the only internet ingress.
LIBREWXR_PORT=8080
LIBREWXR_PUBLIC_URL=https://radar.ezplatforms.com
LIBREWXR_HOST=0.0.0.0
LIBREWXR_MAX_ZOOM=10

# Lowest useful footprint for the European launch. RRQPE and IFS preserve a
# coarse global precipitation layer where native radar is unavailable.
LIBREWXR_ENABLED_REGIONS=EUROPE
LIBREWXR_DPC_ENABLED=false
LIBREWXR_MAX_FRAMES=6
LIBREWXR_FETCH_INTERVAL=600
LIBREWXR_REGIONAL_NWP_ENABLED=false
LIBREWXR_ECMWF_ENABLED=true
LIBREWXR_ECMWF_INTERPOLATION=false
LIBREWXR_RRQPE_ENABLED=true

# LibreWXR nowcast is experimental and deliberately limited to 60 minutes.
LIBREWXR_NOWCAST_ENABLED=true
LIBREWXR_NOWCAST_BLEND_MODE=blended
LIBREWXR_NOWCAST_FRAMES=6
LIBREWXR_ARROW_FLOW_ENABLED=false
LIBREWXR_STORM_CELLS_ENABLED=false

# Features not used by Chetiwa's initial Radar experience.
LIBREWXR_SATELLITE_ENABLED=false
LIBREWXR_ALERTS_ENABLED=false

# Keep one GiB for the host, Docker and cloudflared on the current 4 GiB VM.
# Let LibreWXR read the actual cgroup ceiling so its memory monitor evicts
# caches before Docker reaches that ceiling.
LIBREWXR_MEMORY=3G
LIBREWXR_MEMORY_LIMIT_MB=0
LIBREWXR_MEMORY_PRESSURE_CHECK_INTERVAL=10
# The previous 64 MB budget was continuously saturated and forced expensive
# recomputation during pan/playback. This remains bounded on the 3 GB
# container while covering materially more launch viewports.
LIBREWXR_TILE_CACHE_MB=256
LIBREWXR_COORD_CACHE_SIZE=256
LIBREWXR_COORD_STORE_MB=256
LIBREWXR_NWP_FETCH_CONCURRENCY=1

# Rendering every overview tile for every frame produced 35k jobs after each
# fetch cycle on the 2-vCPU/4-GiB host. Cloudflare is the durable public cache;
# render origin tiles lazily and retain only the bounded hot set above.
LIBREWXR_WARM_OVERVIEW_ZOOM=-1
LIBREWXR_WARM_OVERVIEW_ZOOM_REGIONAL=-1
LIBREWXR_WARM_COORD_ZOOM=-1
