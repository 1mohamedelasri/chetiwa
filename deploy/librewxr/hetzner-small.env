# Chetiwa's low-cost LibreWXR profile for a small Hetzner VM.
#
# This constrained profile provides native radar for Europe and continental USA.
# The 2026-09-19 audit measured memory-limit events and swap during complete
# refreshes. It is not a validated production-capacity profile. See
# docs/release/production-audit-2026-09-19.md before expanding traffic.
# RRQPE/IFS remains the coarse fallback elsewhere. Do not advertise animated
# radar from the global fallback as equivalent to a native regional composite:
# its coarse cells can legitimately have an unusable/zero optical-flow field.

COMPOSE_PROFILES=single

# LibreWXR expects an integer container port. Keep the public host binding
# private in docker-compose; cloudflared is the only internet ingress.
LIBREWXR_PORT=8080
LIBREWXR_PUBLIC_URL=https://radar.ezplatforms.com
LIBREWXR_HOST=0.0.0.0
LIBREWXR_MAX_ZOOM=10

# OPERA covers Europe; USCOMP provides the MRMS/IEM composite required for
# actual storm-cell motion over CONUS. RRQPE alone produced twelve byte-for-
# byte identical future tiles in Arkansas even though the metadata advanced.
# The extra region costs roughly 63 MB per observation plus its generated
# nowcast grids. Complete refreshes still exceed the comfortable working set
# of the current 3 GiB container budget despite allocation fixes.
LIBREWXR_ENABLED_REGIONS=EUROPE,CONUS
LIBREWXR_DPC_ENABLED=false
# Four observed frames retain 30 minutes of useful history while avoiding a
# second full USCOMP working set during each atomic nowcast refresh.
LIBREWXR_MAX_FRAMES=4
LIBREWXR_FETCH_INTERVAL=600
LIBREWXR_REGIONAL_NWP_ENABLED=false
LIBREWXR_ECMWF_ENABLED=true
# The IFS source is hourly. Optical-flow interpolation creates genuine
# ten-minute motion between model hours instead of repeating one raster six
# times and jumping at the next hour. It adds roughly 130 MB RAM and a few
# seconds of CPU per model refresh. This is one component's estimate, not proof
# that the combined radar/model refresh fits the current 3 GiB container.
LIBREWXR_ECMWF_INTERPOLATION=true
LIBREWXR_RRQPE_ENABLED=true

# Chetiwa extends LibreWXR's optical-flow radar trajectory to the complete
# two-hour product. Keeping full radar weight makes the same observed cell
# travel coherently instead of dissolving into a dry, coarser model field.
# The second hour remains an uncertain forecast and is labelled accordingly.
LIBREWXR_NOWCAST_ENABLED=true
# The launch VM has two vCPUs. One OpenCV lane keeps a full CPU available to
# serve cold city tiles while the six-frame optical-flow nowcast regenerates.
# Increase both values only after moving LibreWXR to a larger CPU profile.
LIBREWXR_NOWCAST_WORKERS=1
LIBREWXR_OPENCV_THREADS=1
LIBREWXR_NOWCAST_BLEND_MODE=radar
# Long-lead Gaussian coarsening visibly erodes cells. Disable it for the
# persistent Drops-like trajectory; LibreWXR's flow clamp still bounds
# physically impossible displacement vectors.
LIBREWXR_NOWCAST_COARSEN_ENABLED=false
# Production currently publishes only the first +60 minutes. Generating the
# gated second hour doubled the largest transient allocation and repeatedly
# hit the 3 GiB cgroup during the hourly ECMWF refresh.
LIBREWXR_NOWCAST_FRAMES=6
LIBREWXR_ARROW_FLOW_ENABLED=false
LIBREWXR_STORM_CELLS_ENABLED=false

# Features not used by Chetiwa's initial Radar experience.
LIBREWXR_SATELLITE_ENABLED=false
LIBREWXR_ALERTS_ENABLED=false

# Reserve the remainder for the host, Docker, API and cloudflared on the current
# nominal 4 GB VM. This ceiling still caused swap/pressure in the audited cycle.
# A VM resize alone does not change this container ceiling; validate a matching
# memory allowance after an approved upgrade. Do not set 6G on the current VM.
# Let LibreWXR read the actual cgroup ceiling so its memory monitor evicts
# caches before Docker reaches that ceiling.
LIBREWXR_MEMORY=3G
LIBREWXR_MEMORY_LIMIT_MB=0
LIBREWXR_MEMORY_PRESSURE_CHECK_INTERVAL=10
# The 128 MB budget was continuously displaced by the older 16-frame animation
# workload across two regions. 256 MB avoids some repeated tile rendering, but
# its headroom must be assessed together with frame/flow/model allocations.
LIBREWXR_TILE_CACHE_MB=256
# Each LRU entry retains a mapped coordinate array. A 256-entry budget per
# cache kept roughly 460 MB of mapped coordinate pages active while atomic
# radar/nowcast refreshes temporarily held both generations. Bound the hot map
# set so interactive tiles retain useful reuse without forcing anonymous frame
# arrays into swap every ten minutes.
LIBREWXR_COORD_CACHE_SIZE=128
# 128 MB caused destructive prune/rebuild churn, while 512 MB was too large for
# the 3 GiB cgroup during frame replacement. 256 MB is the small-host balance:
# enough for the launch viewports and their padded/fractional variants, with
# half the former worst-case page-cache footprint.
LIBREWXR_COORD_STORE_MB=256
LIBREWXR_NWP_FETCH_CONCURRENCY=1

# Rendering every overview tile for every frame produced 35k jobs after each
# fetch cycle on the 2-vCPU/4-GiB host. Cloudflare is the durable public cache;
# render origin tiles lazily and retain only the bounded hot set above.
LIBREWXR_WARM_OVERVIEW_ZOOM=-1
LIBREWXR_WARM_OVERVIEW_ZOOM_REGIONAL=-1
LIBREWXR_WARM_COORD_ZOOM=-1
