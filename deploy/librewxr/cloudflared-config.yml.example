# Copy to /etc/cloudflared/config.yml and replace the tunnel identifiers.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

# Reuse origin connections instead of creating a new local connection for
# every metadata/tile request. Cloudflare still terminates public TLS.
originRequest:
  connectTimeout: 5s
  keepAliveConnections: 100
  keepAliveTimeout: 90s
  # Keep HTTP/1.1: http2Origin requires a TLS-enabled origin, while LibreWXR
  # is intentionally private plain HTTP on 127.0.0.1.
  http2Origin: false

ingress:
  - hostname: radar.ezplatforms.com
    service: http://127.0.0.1:8080
  - service: http_status:404
