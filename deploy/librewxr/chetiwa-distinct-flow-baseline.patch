+class _HistoryFrameStore:
+    """FrameStore stub with an arbitrary timestamp -> regions history."""
+
+    def __init__(self, frames: dict[int, dict]):
+        self._frames = frames
+
+    async def get_timestamps(self):
+        return sorted(self._frames)
+
+    async def get_frame(self, ts):
+        from librewxr.data.store import RadarFrame
+        regions = self._frames.get(ts)
+        if regions is None:
+            return None
+        return RadarFrame(timestamp=ts, regions=dict(regions))
